# Copy to .env.local (git-ignored) in your deck, or at the root of this
# repository to run `npm run dev` / `npm run preview`.

# Address of the bar: 10.0.4.20 over USB (default), its IP over Wi-Fi.
BUSYBAR_ADDR=10.0.4.20

# HTTP access code of the bar ("HTTP Access" setting, key mode). Needed over
# Wi-Fi only. Not a BUSY cloud token.
BUSYBAR_PASSWORD=

# Uncomment to turn the addon off, change the end sound, or log every call.
# BUSYBAR_ENABLED=false
# BUSYBAR_SOUND=shared/calendar_reminder_ends.wav
# BUSYBAR_WARN_SOUND=shared/volume_change.wav
# BUSYBAR_DEBUG=true
