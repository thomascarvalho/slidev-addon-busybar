{
  "name": "slidev-addon-busybar",
  "type": "module",
  "version": "0.5.0",
  "description": "Drive a BUSY Bar from your Slidev deck: current chapter and progress, workshop timers, break and Q&A screens.",
  "author": "Thomas Carvalho",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomascarvalho/slidev-addon-busybar.git"
  },
  "keywords": [
    "slidev-addon",
    "slidev",
    "busy-bar",
    "busybar",
    "presentation",
    "timer"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "!src/**/*.test.ts",
    "!src/preview.ts",
    "dist",
    "global-bottom.vue",
    "setup",
    "src",
    "vite.config.ts"
  ],
  "engines": {
    "node": ">=20.12",
    "slidev": ">=52.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "dev": "npm run build && slidev example/slides.md --open",
    "preview": "node --env-file=.env.local src/preview.ts",
    "prepack": "npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "@slidev/cli": ">=52.0.0",
    "vite": ">=6.0.0"
  },
  "dependencies": {
    "@busy-app/busy-lib": "^0.21.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "typescript": "~5.9.3"
  }
}
